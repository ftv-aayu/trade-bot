# trade-bot configuration
# Copy this to .env and edit as needed.
# No API key required - uses Binance public market data only.

# --- Binance ---
# Optional: override the data endpoint (default: https://data-api.binance.vision)
# BINANCE_BASE_URL=https://data-api.binance.vision

# --- Symbols to watch (comma-separated Binance USDT pairs) ---
# WATCH_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,ADAUSDT,XRPUSDT,DOGEUSDT,AVAXUSDT,DOTUSDT,MATICUSDT

# --- Stocks (Yahoo Finance tickers, US market only) ---
STOCKS_ENABLED=true
# WATCH_STOCKS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,V,UNH,XOM,JNJ,WMT,PG,MA,HD,CVX,ABBV,MRK,COST
STOCK_INTERVAL=5m       # 5m = up to 60 days history from Yahoo Finance
STOCK_POLL_SECONDS=300  # poll stocks every 5 minutes

# --- Polling ---
POLL_SECONDS=60
KLINE_INTERVAL=1m

# --- Paths ---
BOT_DB_PATH=data/trade_bot.sqlite3
LOG_FILE=logs/bot.log

# --- Predictor ---
PREDICTOR_ENABLED=true
PREDICTOR_MIN_SAMPLES=5000
PREDICTOR_HISTORY_LIMIT=25000
PREDICTION_HORIZON=60
PREDICTION_RETRAIN_SECONDS=1800

# --- Dashboard ---
DASHBOARD_REFRESH=5
