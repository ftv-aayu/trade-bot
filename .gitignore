# Database — never commit live trading data
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal
data/*.db

# Keep the placeholder so the directory exists in git
!data/.gitkeep

# Logs
logs/*.log
logs/*.jsonl
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environment
.venv/
venv/
env/

# Environment secrets — never commit
.env

# Distribution / packaging
dist/
build/
*.egg-info/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
